    "다리걸기 → 구두 슛 → 내선 연결 → 어퍼컷": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg Sweep → Wingtip Punt → Extension Call → Uppercut"
          }
        }
      }
    },
    "다리걸기 → 밟기": {
      "extractionState": "manual",
      "localizations": {
