    },
    "전용 옷 · 컷인 초상화": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclusive outfit · cut-in portrait"
          }
        }
      }
    },
    "전조등이 어둠을 가른다. 종점까지 남은 건 두목뿐": {
