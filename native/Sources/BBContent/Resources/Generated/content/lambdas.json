 "PE_CTL[2][1][0][3]": "P=>peNrm(P.uF*22.5-90)",
 "PE_CTL[2][1][0][4]": "(P,v)=>{ const bd=P.lF-P.uF; P.uF=(v+90)/22.5; P.lF=P.uF+bd; }",
 "PE_CTL[2][1][1][3]": "P=>peNrm((P.lF-P.uF)*22.5)",
