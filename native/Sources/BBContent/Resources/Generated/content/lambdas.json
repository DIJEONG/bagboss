 "TYPES.gbuf.glsl": "c=>`vec4 ${c.o('raw')}=gInfo(ivec2(0));\nfloat ${c.o('mat')}=floor(${c.o('raw')}.r*255.0+0.5);\nfloat ${c.o('tone')}=${c.o('raw')}.g*2.0;\nfloat ${c.o('emit')}=${c.o('raw')}.b*uEmitK;\nfloat ${c.o('mask')}=step(0.75,${c.o('raw')}.a);\nvec3 ${c.o('normal')}=gNormal();\nvec3 ${c.o('base')}=pal(0.0,${c.o('mat')},3.0);\nfloat ${c.o('lum')}=luma(${c.o('base')});`",
 "TYPES.lights.glsl": "c=>`vec3 ${c.o('light')}=lightSum(${c.i('normal')})*${c.p('gain')}+vec3(${c.p('amb')})*uAmb;\nfloat ${c.o('lum')}=dot(${c.o('light')},vec3(0.3333));\nvec3 ${c.o('tint')}=${c.o('light')}/max(max(${c.o('light')}.r,max(${c.o('light')}.g,${c.o('light')}.b)),1e-3);`",
 "TYPES.relief.glsl": "c=>`float ${c.o('sh')}=reliefShadow(${c.p('len')})*${c.p('str')};`",
 "TYPES.rim.glsl": "c=>`float ${c.o('rim')}=rimSum(${c.i('normal')})*${c.p('str')};`",
 "TYPES.value.glsl": "c=>`float ${c.o('v')}=${c.p('v')};`",
 "TYPES.color.glsl": "c=>`vec3 ${c.o('c')}=${c.p('c')};`",
 "TYPES.add.glsl": "c=>`float ${c.o('o')}=${c.i('a')}+${c.i('b')};`",
 "TYPES.mul.glsl": "c=>`float ${c.o('o')}=${c.i('a')}*${c.i('b')};`",
 "TYPES.invert.glsl": "c=>`float ${c.o('o')}=1.0-${c.i('a')};`",
 "TYPES.lumOf.glsl": "c=>`float ${c.o('o')}=luma(${c.i('c')});`",
 "TYPES.mulc.glsl": "c=>`vec3 ${c.o('o')}=${c.i('c')}*${c.i('v')};`",
 "TYPES.mulcc.glsl": "c=>`vec3 ${c.o('o')}=${c.i('a')}*${c.i('b')};`",
 "TYPES.addc.glsl": "c=>`vec3 ${c.o('o')}=${c.i('a')}+${c.i('b')};`",
 "TYPES.mixc.glsl": "c=>`vec3 ${c.o('o')}=mix(${c.i('a')},${c.i('b')},clamp(${c.i('t')},0.0,1.0));`",
 "TYPES.levels.glsl": "c=>`float ${c.o('o')}=pow(clamp((${c.i('a')}-${c.p('lo')})/max(${c.p('hi')}-${c.p('lo')},1e-3),0.0,1.0),${c.p('g')});`",
 "TYPES.posterize.glsl": "c=>`float ${c.o('o')}=min(floor(clamp(${c.i('a')},0.0,1.0)*${c.p('n')}),${c.p('n')}-1.0)/max(${c.p('n')}-1.0,1.0);`",
 "TYPES.ramp.glsl": "c=>`float ${c.o('lv')}=clamp(${c.i('level')},0.0,1.0)*${STEPS}.0+(thr(0.0)-0.5)*${c.p('dith')};\nvec3 ${c.o('color')}=pal(${c.p('pal')},${c.i('mat')},clamp(floor(${c.o('lv')}),0.0,${STEPS-1}.0))*mix(vec3(1.0),${c.i('tint')},${c.p('tintAmt')});`",
 "TYPES.dither.glsl": "c=>`float ${c.o('o')}=clamp(floor(clamp(${c.i('a')},0.0,1.0)*(${c.p('lv')}-1.0)+(thr(${c.p('pat')})-0.5)*${c.p('str')}+0.5),0.0,${c.p('lv')}-1.0)/(${c.p('lv')}-1.0);`",
 "TYPES.matdither.glsl": "c=>`float ${c.o('t')}=${c.p('mode')}<0.5 ? 1.0-matThr(${c.i('mat')}) : thr(0.0);\nfloat ${c.o('o')}=clamp(floor(clamp(${c.i('a')},0.0,1.0)*(${c.p('lv')}-1.0)+(${c.o('t')}-0.5)*${c.p('str')}+0.5),0.0,${c.p('lv')}-1.0)/(${c.p('lv')}-1.0);`",
 "TYPES.edgeval.glsl": "c=>`float ${c.o('o')}=mix(${c.i('a')},${c.p('v')},edgeOut(${c.p('th')}+1.0));`",
 "TYPES.fog.glsl": "c=>`vec3 ${c.o('o')}=mix(${c.i('c')}, ${c.p('mode')}<0.5?uSky:${c.p('col')}, smoothstep(${c.p('start')},1.0,gDepth())*${c.p('amt')});`",
 "TYPES.twotone.glsl": "c=>`vec3 ${c.o('color')}=mix(${c.p('ink')},${c.p('paper')},clamp(${c.i('a')},0.0,1.0));`",
 "TYPES.grad4.glsl": "c=>`float ${c.o('i')}=floor(clamp(${c.i('a')},0.0,1.0)*3.0+0.5);\nvec3 ${c.o('color')}=${c.o('i')}<0.5?${c.p('c0')}:(${c.o('i')}<1.5?${c.p('c1')}:(${c.o('i')}<2.5?${c.p('c2')}:${c.p('c3')}));`",
 "TYPES.charline.glsl": "c=>`vec3 ${c.o('o')}=${c.i('color')}; { vec4 so=selOut(${c.p('pal')}); vec4 me=gInfo(ivec2(0)); bool sel=${c.p('sel')}>0.5;\n      if(${c.p('outer')}>0.5 && so.a>0.5) ${c.o('o')}= sel ? mix(so.rgb, ${c.p('tint')}, 0.45) : so.rgb;\n      else if(${c.p('inner')}>0.5 && innerLine()>0.5){ vec3 d0=pal(0.0,floor(me.r*255.0+0.5),${c.p('pal')})*0.9;\n        ${c.o('o')}= sel ? mix(${c.i('color')}*0.5+${c.p('tint')}*0.3, d0, 0.35) : d0; } }`",
 "TYPES.outline.glsl": "c=>`vec3 ${c.o('o')}=mix(${c.i('color')},${c.p('col')},edgeOut(${c.p('th')}+1.0));`",
 "TYPES.output.glsl": "c=>`oC=vec4(clamp(${c.i('color')},0.0,1.0),1.0);`",
 "TW_OT[1].ap": "T=>{ T.hpK*=1.15; }",
 "TW_OT[2].ap": "T=>{ T.limit-=1; }",
 "TW_OT[3].ap": "T=>{ T.blackSet.add(3); T.blackSet.add(13); }",
 "TW_OT[4].ap": "T=>{ T.dmgK*=1.2; }",
 "TW_OT[5].ap": "T=>{ T.kit=false; T.restK=.5; }",
 "TW_OT[6].ap": "T=>{ T.bossK*=1.3; for(const n of [10,20]) if(T.waves[n]) T.waves[n].push('guardL'); }",
 "TW_MODS[0].ap": "T=>{ T.limit=6; }",
 "TW_MODS[1].ap": "(T,r)=>{ const c=[2,3,4,6,8,9]; T.blackSet.add(c[Math.floor(r()*c.length)]); }",
 "TW_MODS[2].ap": "(T,r)=>{ for(const k in T.waves) T.waves[k]=T.waves[k].map(t=>t==='valet'&&r()<.5?'courier':t); }",
 "TW_MODS[3].ap": "(T,r)=>{ for(const k in T.waves) if(T.waves[k].length && !TW_FLOORS[k].boss && r()<.6) T.waves[k].push('guardL'); }",
 "TW_MODS[4].ap": "(T,r)=>{ for(const k in T.waves) if(T.waves[k].length && !TW_FLOORS[k].boss && r()<.6) T.waves[k].push('janitor'); }",
 "TW_MODS[5].ap": "T=>{ for(const k of [3,6,9]) if(T.waves[k] && T.waves[k].length) T.waves[k].push('tech'); }",
 "OPTS.crit.f": "v=>`치명 +${Math.round(v*100)}%`",
 "OPTS.critd.f": "v=>`치명 피해 +${Math.round(v*100)}%`",
 "OPTS.dmg.f": "v=>`피해 +${Math.round(v*100)}%`",
 "OPTS.cd.f": "v=>`쿨다운 −${Math.round(v*100)}%`",
